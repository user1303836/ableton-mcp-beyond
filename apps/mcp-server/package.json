{
  "name": "@ableton-mcp/mcp-server",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "abletonMcpSupport": {
    "nodeMajors": [
      22,
      24,
      25
    ]
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "ableton-mcp-server": "./dist/src/cli.js",
    "ableton-mcp-setup": "./dist/src/setup.js",
    "ableton-mcp-migrate": "./dist/src/migrate.js",
    "ableton-mcp-diagnostics": "./dist/src/diagnostics.js",
    "ableton-mcp-install-remote-script": "./dist/src/install-remote-script.js",
    "ableton-mcp-lifecycle": "./dist/src/lifecycle-cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "!dist/src/benchmark.*",
    "!dist/src/analysis-worker.*",
    "remote-script/AbletonMcpBridge",
    "remote-script/README.md",
    "release-docs",
    "release-manifest.json",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22 <23 || >=24 <25 || >=25 <26"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs && node --test scripts/release-documentation.test.mjs scripts/capability-manifest.test.mjs",
    "property-test": "npm run build && node --test dist/test/property.test.js",
    "coverage": "npm run build && node scripts/run-coverage.mjs",
    "benchmark": "npm run build && node dist/src/benchmark.js && node --test dist/test/benchmark.test.js",
    "audio:oracle": "npm run build && node scripts/verify-audio-oracle.mjs",
    "audio:live-verify": "node scripts/verify-phase8-live.mjs",
    "policy:verify": "node scripts/verify-node-policy.mjs",
    "compatibility": "npm run policy:verify && node scripts/check-compatibility.mjs",
    "package": "npm pack --json",
    "package:verify": "npm run build && node scripts/verify-package.mjs",
    "journey:verify": "npm run build && node scripts/verify-production-journey.mjs",
    "setup": "node dist/src/setup.js",
    "migrate": "node dist/src/migrate.js",
    "diagnostics": "node dist/src/diagnostics.js",
    "start": "node dist/src/cli.js",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run policy:verify && npm run build && node scripts/stage-remote-script.mjs && node scripts/stage-release-artifact.mjs",
    "capability:manifest": "node scripts/generate-capability-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "semver": "^7.7.2",
    "typescript": "^5.9.2"
  }
}
