# macOS metadata
.DS_Store

# Locally supplied Ableton Extensions SDK (pre-release; its licence forbids redistributing it)
/extensions-sdk-1.0.0-beta.0/
/vendor/ableton-extensions-sdk*/

# Smithers workflow/runtime state and locally provisioned agent skills (ephemeral — never commit)
/.smithers/
smithers.db
smithers.db-shm
smithers.db-wal
/.agents/
/.claude/
/.pi-subagents/
apps/mcp-server/remote-script/
apps/mcp-server/live-extension/
apps/mcp-server/release-docs/
apps/mcp-server/release-manifest.json
apps/mcp-server/LICENSE.md
apps/mcp-server/*.tgz

# Python bytecode
__pycache__/
*.pyc
/.pi/

# Kumi workspace generated output
/node_modules/
/apps/kumi/node_modules/
/apps/kumi/dist/
/packages/runtime/node_modules/
/packages/runtime/dist/
/apps/live-extension/node_modules/
# scripts/build-release.mjs output
/release/

# Local review bookkeeping
docs/evidence/willington-review.json
# Kumi's Mac helper, built for releases (scripts/build-hands.mjs)
packages/runtime/hands/

/target/

# Local port inventory and agent handoff notes
/.port-notes/
